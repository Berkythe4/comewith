{
  "name": "comewith-desktop",
  "version": "1.0.0",
  "description": "Come With team dashboard as a phone-sized desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.comewith.team",
    "productName": "Come With",
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
