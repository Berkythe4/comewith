# Secrets — never commit
.beatport_token.json
.env
.env.local
.env.production
.env.*.local
*.secret

# Resend / recipient exports contain email addresses (PII) — keep local, never commit
emails-sent-*.csv

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Come With Radio working files: keep the folder + docs/art tracked, but not
# heavy mix masters. Commit finished small covers; keep big audio/video local.
Radio/**/*.wav

# Radio render — generated working files (regenerate with weekly_prep.py)
Radio/render/EP*_cues.csv

# Come With Radio — weekly episode folders: keep the small records
# (tracklist.json, chapters, cues, docs), ignore heavy audio/video masters.
Radio/Week */*.wav
Radio/Week */*.mp4
Radio/Week */*.mov
Radio/Week */*.m4a
Radio/Week */*.flac
Radio/Week */*.aac
Radio/Week */*.aiff

supabase/.temp/

# Radio media — renders, masters and full-size cover art.
# A `git add -A` over Radio/ once staged ~750 MB of MP4s and 200 MB of JPEGs in
# one commit. These are build outputs or huge source assets; the cues, the times
# sheets and the scripts that make them are what belongs in git.
Radio/**/Audio_Video_Final/
Radio/**/Cover Art/
Radio/**/*.mp4
Radio/**/*.wav
Radio/**/*.WAV
Radio/**/*.mp3
Radio/Elements-26/render/element_slides/
Radio/Elements-26/render/frames/
Radio/Elements-26/render/proto/
Radio/Elements-26/render/final/
Radio/Elements-26/render/final2/
Radio/Elements-26/render/henryck/
Radio/Video/_preview/
