# =============================================================================
# Come With Platform — Environment Variable Contract
# =============================================================================
# Copy this file to .env.local for local development.
# In Netlify, set these in Site Settings → Environment Variables.
# In Supabase Edge Functions, set via: supabase secrets set KEY=value
#
# NEVER commit .env.local or any file with real values to git.
# The .gitignore should already cover .env*
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Production
# -----------------------------------------------------------------------------
# These are PUBLIC (safe in frontend HTML/JS):
SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE

# This is PRIVATE — server / Edge Functions only. NEVER ship in frontend code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# -----------------------------------------------------------------------------
# Supabase — Staging (use these when developing locally)
# -----------------------------------------------------------------------------
SUPABASE_STAGING_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_STAGING_ANON_KEY=sb_publishable_YOUR_STAGING_PUBLISHABLE_KEY
SUPABASE_STAGING_SERVICE_ROLE_KEY=sb_secret_YOUR_STAGING_SECRET_KEY

# -----------------------------------------------------------------------------
# Resend
# -----------------------------------------------------------------------------
# Used by Edge Functions to send transactional + broadcast email.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Sender identities (must be on the verified comewith.org domain)
RESEND_FROM_DEFAULT=Berky <berky@comewith.org>
RESEND_FROM_HELLO=Come With <hello@comewith.org>
RESEND_REPLY_TO=hello@comewith.org

# Resend Audiences IDs (created during Phase 8 — fill in when ready)
RESEND_AUDIENCE_MAIN=YOUR_AUDIENCE_UUID
RESEND_AUDIENCE_DI=YOUR_DI_AUDIENCE_UUID

# Resend webhook signing secret (created during Phase 9)
RESEND_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=production              # 'production' | 'staging' | 'local'
APP_PUBLIC_URL=https://comewith.org
APP_ADMIN_EMAIL=berky@comewith.org

# Token used by the website to authenticate inbound webhook calls (Resend → Supabase).
APP_INTERNAL_WEBHOOK_TOKEN=GENERATE_RANDOM_32_CHAR_STRING
